# ── Email (module: email) ─────────────────────────────────────────────────────
# Both are required. With either missing the app still boots and signs users up;
# verification and password reset stay off, and every message is recorded in
# email_outbox with status 'captured' so a dev or an E2E test can follow the link.
RESEND_API_KEY=                       # from resend.com → API Keys
EMAIL_FROM=                           # must be on a domain verified at Resend, e.g. "App <hi@example.com>"
