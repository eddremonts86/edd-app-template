# ── Billing (module: billing) ─────────────────────────────────────────────────
# Without STRIPE_SECRET_KEY the app boots, the billing page renders, and checkout
# refuses with a sentence. Webhooks are configured separately and are separately
# absent: checkout works without them, it just never hears back.
STRIPE_SECRET_KEY=                    # dashboard.stripe.com → Developers → API keys
STRIPE_WEBHOOK_SECRET=                # from the endpoint you create for /api/billing/webhook
# Set during a rotation only. Both are accepted while it is set, so no event is
# dropped in the window where Stripe may sign with either.
STRIPE_WEBHOOK_SECRET_PREVIOUS=
