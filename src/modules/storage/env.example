# ── Object storage (module: storage) ──────────────────────────────────────────
# Disabled by default. Storage is the one integration that refuses to degrade:
# a fallback would let uploads appear to work while the files went nowhere.
#
# STORAGE_PROVIDER is required and has no default — "local" is never assumed,
# because a container's disk does not survive a deploy.
STORAGE_PROVIDER=                     # "s3" or "local"

# s3 — all four required. Defaults are shaped for self-hosted MinIO; the
# endpoint URL says who is serving it, so the names do not name a vendor.
STORAGE_ENDPOINT=                     # e.g. https://minio.example.com
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=                       # optional; defaults to "auto"

# local — development only, refused when NODE_ENV=production
STORAGE_LOCAL_DIR=                    # e.g. ./.storage
STORAGE_LOCAL_ROUTE_PREFIX=           # optional; defaults to /api/storage/local
