# edd-app-template — Environment Configuration
# Copy this file to .env and fill in values for your environment.
# See tasks/env-unification-plan.md for the full naming convention reference.
# NEVER commit .env — only .env.example is tracked.

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=2999
APP_URL=http://localhost:2999          # Public base URL (auth redirects, webhooks)

# ── Database ──────────────────────────────────────────────────────────────────
# Dev DB runs on port 5433 to avoid conflicts when running multiple apps
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/edd_app_template

# Encrypts the passwords and connection strings stored by the database admin
# surface (/dashboard/admin/database), AES-256-GCM with a scrypt-derived key.
# At least 16 characters. Without it that page refuses every write rather than
# storing credentials in plaintext.
DB_CONFIG_SECRET=change-me-use-openssl-rand-base64-32  # openssl rand -base64 32

# ── Authentication ────────────────────────────────────────────────────────────
AUTH_MODE=hybrid                       # local | clerk | hybrid
VITE_AUTH_MODE=hybrid                  # client-side mirror — must match AUTH_MODE
BETTER_AUTH_SECRET=change-me-use-openssl-rand-base64-32  # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:2999  # must match APP_URL
VITE_BETTER_AUTH_URL=http://localhost:2999  # client-side mirror — must match BETTER_AUTH_URL
# Clerk (required when AUTH_MODE=clerk or hybrid)
CLERK_SECRET_KEY=                      # sk_test_... from clerk.com → API Keys
VITE_CLERK_PUBLISHABLE_KEY=            # pk_test_... from clerk.com → API Keys

# ── AI — Local Providers (development only — NOT used in production) ──────────
# Unified AI backend (development only)
# Set this to the base URL of your preferred local AI provider (Ollama, llama.cpp, LM Studio, etc.)
AI_API_BASE_URL=http://localhost:11435/v1  # Default: Ollama

# These point to the shared workspace containers started from the workspace root:
#   docker compose --profile ai up -d
#

# Individual provider URLs (override AI_API_BASE_URL if needed)
AI_OLLAMA_BASE_URL=http://localhost:11435/v1
AI_LLAMA_CPP_BASE_URL=http://localhost:8080/v1
AI_LMSTUDIO_BASE_URL=http://localhost:1234/v1
AI_OLLAMA_MODEL=qwen3.5:2b
AI_LMSTUDIO_MODEL=qwen3.5-2b
OLLAMA_ORIGINS=*
# Legacy alias — prefer AI_API_BASE_URL above.
VITE_AI_BASE_URL=http://localhost:11435/v1

# ── AI — Cloud Providers (production) ─────────────────────────────────────────
MINIMAX_API_KEY=                      # from platform.minimaxi.chat (primary LLM)
MINIMAX_BASE_URL=https://api.minimaxi.chat/v1
MINIMAX_MODEL=MiniMax-M3
OPENAI_API_KEY=                       # optional fallback
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=                    # optional fallback
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ── Default local admin (seeded by db:seed:admin) ────────────────────────────
# Run `pnpm db:seed:admin` after migrations to create the initial admin user.
# These same values live in the workspace-level .env so they stay consistent.
DEFAULT_ADMIN_EMAIL=edd_admin@local.com
DEFAULT_ADMIN_PASSWORD=Passw0rd!234

# ── Observability ─────────────────────────────────────────────────────────────
VITE_SENTRY_DSN=                      # from sentry.io → Project → DSN (empty = disabled)

# ── RAG / embeddings ──────────────────────────────────────────────────────────
# Every value below has a working local default; set them only to point
# elsewhere. `pnpm rag:ingest` needs ChromaDB reachable.
CHROMADB_URL=http://localhost:8000
AI_EMBEDDING_URL=http://localhost:1234/v1/embeddings
AI_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
AI_EMBEDDING_TIMEOUT_MS=4000
AI_API_KEY=lm-studio                  # LM Studio ignores the value; a cloud embedder will not

# ── E2E auth bypass — never set any of these in a deployed environment ────────
# The bypass refuses to engage unless NODE_ENV is not production AND the server
# host is local, so a stray value cannot open a deployed app. Documented here
# because they are read in src/ and an undocumented switch is worse than a
# visible one.
HOST=                                 # server bind host; the bypass only runs when this is local
SKIP_AUTH=                            # 'true' to bypass auth in local E2E runs
VITE_SKIP_AUTH=                       # client-side twin of SKIP_AUTH
VITE_E2E=                             # 'true' when running under Playwright
TEST_USER_ID=                         # id the bypass signs in as (default: mock_user_id)
VITE_TEST_USER_ID=                    # client-side twin of TEST_USER_ID
# ── Email (module: email) ─────────────────────────────────────────────────────
# Both are required. With either missing the app still boots and signs users up;
# verification and password reset stay off, and every message is recorded in
# email_outbox with status 'captured' so a dev or an E2E test can follow the link.
RESEND_API_KEY=                       # from resend.com → API Keys
EMAIL_FROM=                           # must be on a domain verified at Resend, e.g. "App <hi@example.com>"
# ── Billing (module: billing) ─────────────────────────────────────────────────
# Without STRIPE_SECRET_KEY the app boots, the billing page renders, and checkout
# refuses with a sentence. Webhooks are configured separately and are separately
# absent: checkout works without them, it just never hears back.
STRIPE_SECRET_KEY=                    # dashboard.stripe.com → Developers → API keys
STRIPE_WEBHOOK_SECRET=                # from the endpoint you create for /api/billing/webhook
# Set during a rotation only. Both are accepted while it is set, so no event is
# dropped in the window where Stripe may sign with either.
STRIPE_WEBHOOK_SECRET_PREVIOUS=
# ── Object storage (module: storage) ──────────────────────────────────────────
# Disabled by default. Storage is the one integration that refuses to degrade:
# a fallback would let uploads appear to work while the files went nowhere.
#
# STORAGE_PROVIDER is required and has no default — "local" is never assumed,
# because a container's disk does not survive a deploy.
STORAGE_PROVIDER=                     # "s3" or "local"

# s3 — all four required. Points at the shared actives-minio container
# (.infra/docker-compose.yml, bucket already created there) — set
# STORAGE_PROVIDER=s3 above to actually use it. Port is 9002, not MinIO's
# standard 9000 — that's builderhunt's own MinIO's reserved port
# (INTERVIEW_R2_ENDPOINT in its .env), even when builderhunt's isn't running.
STORAGE_ENDPOINT=http://localhost:9002
STORAGE_BUCKET=edd-app-template
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=b45cJ9Lx2tf3cBeb5yo_73M3FhQSkA0i
STORAGE_REGION=                       # optional; defaults to "auto"

# local — development only, refused when NODE_ENV=production
STORAGE_LOCAL_DIR=                    # e.g. ./.storage
STORAGE_LOCAL_ROUTE_PREFIX=           # optional; defaults to /api/storage/local
